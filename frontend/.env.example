# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# Get this from the Clerk Dashboard: Configure > API keys > Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=

# Only needed if your backend isn't running on the default localhost:8080
# VITE_API_BASE_URL=http://localhost:8080/api
