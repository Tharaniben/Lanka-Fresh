# ============================================================
# LankaFresh — Environment Variables Reference
# ============================================================
# Copy this file to .env (repo root) and fill in real values.
# Never commit .env — it is already in .gitignore.
# Share the actual values with teammates privately (not in chat or commits).
# ============================================================

# --- Backend: MySQL database ---
DB_NAME=lankafresh
DB_USERNAME=root
DB_PASSWORD=

# --- Backend: Clerk JWT verification ---
# Get from Clerk Dashboard → Configure → API Keys → Advanced → JWKS URL
# Format: https://your-app-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
